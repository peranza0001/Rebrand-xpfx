generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ────────────────────────────────────────────────────────────────────

model User {
  id                         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                   String       @unique
  email                      String       @unique
  fullName                   String       @map("full_name")
  phone                      String?
  country                    String?
  passwordHash               String       @map("password_hash")
  securityType               String       @map("security_type")
  role                       String       @default("user")
  kycVerified                Boolean      @map("kyc_verified") @default(false)
  kycStatus                  String       @map("kyc_status") @default("unverified")
  emailVerified              Boolean      @map("email_verified") @default(false)
  phoneVerified              Boolean      @map("phone_verified") @default(false)
  emailVerifyToken           String?      @map("email_verify_token")
  resetPasswordToken         String?      @map("reset_password_token")
  resetPasswordExpiry        DateTime?    @map("reset_password_expiry")
  avatarUrl                  String?      @map("avatar_url")
  selectedManagerId          String?      @map("selected_manager_id")
  demoMode                   Boolean      @map("demo_mode") @default(false)
  aiBotTrialEndsAt           DateTime?    @map("ai_bot_trial_ends_at")
  aiBotSubscriptionStatus    String       @map("ai_bot_subscription_status") @default("trial")
  maintenanceDueAt           DateTime?    @map("maintenance_due_at")
  maintenanceGraceEndsAt     DateTime?    @map("maintenance_grace_ends_at")
  lastCompulsoryTradeAt      DateTime?    @map("last_compulsory_trade_at")
  tradingLocked              Boolean      @map("trading_locked") @default(false)
  lastActivity               DateTime     @map("last_activity") @default(now())
  createdAt                  DateTime     @map("created_at") @default(now())
  referralCode               String?      @map("referral_code") @unique
  referredBy                 String?      @map("referred_by")
  referralValidUntil         DateTime?    @map("referral_valid_until")
  isNewUser                  Boolean      @map("is_new_user") @default(true)
  moonpayEmail               String?      @map("moonpay_email")
  buyVerified                Boolean      @map("buy_verified") @default(false)

  sessions                   UserSession[]
  transactions               Transaction[]
  notifications              Notification[]
  kycDocuments               KYCDocument[]
  tradingAccounts            TradingAccount[]
  auditLogs                  AuditLog[]
  copyRelationships           CopyRelationship[]
  copyEvents                  CopyEvent[]

  @@map("users")
}

model InvestmentRecord {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String   @map("user_id") @db.Uuid
  planId                   String   @map("plan_id")
  planName                 String   @map("plan_name")
  status                   String   @default("active")
  principal                Decimal  @db.Decimal(20, 2)
  lockedProfit             Decimal  @default(0) @map("locked_profit") @db.Decimal(20, 2)
  currentDay               Int      @default(0) @map("current_day")
  startDate                DateTime @map("start_date") @db.Timestamp(6)
  endDate                  DateTime  @map("end_date") @db.Timestamp(6)
  weeklyTopUpDue           Boolean  @default(false) @map("weekly_top_up_due")
  weeklyTopUpAmount        Decimal  @default(0) @map("weekly_top_up_amount") @db.Decimal(20, 2)
  weeklyTopUpDueSince      DateTime? @map("weekly_top_up_due_since") @db.Timestamp(6)
  weeklyTopUpPaidAt        DateTime? @map("weekly_top_up_paid_at") @db.Timestamp(6)
  weeklyTopUpApproved      Boolean  @default(false) @map("weekly_top_up_approved")
  topUpPenaltyActive       Boolean  @default(false) @map("top_up_penalty_active")
  pendingMarginalFee       Decimal  @default(0) @map("pending_marginal_fee") @db.Decimal(20, 2)
  marginalFeeDueSince      DateTime? @map("marginal_fee_due_since") @db.Timestamp(6)
  marginalFeePaidAt        DateTime? @map("marginal_fee_paid_at") @db.Timestamp(6)
  marginalFeeApproved      Boolean  @default(false) @map("marginal_fee_approved")
  dailyHistory             Json     @default("[]") @map("daily_history")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([userId, status])
  @@map("investment_records")
}

model CopyLeader {
  id              String             @id @default(uuid())
  displayName     String             @map("display_name")
  strategy        String
  riskLevel       String             @map("risk_level")
  monthlyReturn   Decimal            @default(0) @map("monthly_return") @db.Decimal(10, 4)
  winRate         Decimal            @default(0) @map("win_rate") @db.Decimal(10, 4)
  maxDrawdown     Decimal            @default(0) @map("max_drawdown") @db.Decimal(10, 4)
  followerCount   Int                @default(0) @map("follower_count")
  suspended       Boolean            @default(false)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  relationships   CopyRelationship[]
  events          CopyEvent[]

  @@map("copy_leaders")
}

model CopyRelationship {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  leaderId        String      @map("leader_id")
  allocationPct   Decimal     @map("allocation_pct") @db.Decimal(6, 3)
  status          String      @default("active")
  startedAt       DateTime    @default(now()) @map("started_at")
  stoppedAt       DateTime?   @map("stopped_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  leader          CopyLeader  @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  events          CopyEvent[]

  @@unique([userId, leaderId])
  @@index([userId, status])
  @@map("copy_relationships")
}

model CopyEvent {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  leaderId        String            @map("leader_id")
  relationshipId  String?           @map("relationship_id")
  symbol          String
  side            String
  status          String            @default("simulated")
  notional        Decimal           @db.Decimal(18, 8)
  simulated       Boolean           @default(true)
  createdAt       DateTime          @default(now()) @map("created_at")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  leader          CopyLeader        @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  relationship    CopyRelationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("copy_events")
}

// ─── KYC DOCUMENTS ────────────────────────────────────────────────────────────

model KYCDocument {
  id          String      @id @default(uuid())
  userId      String
  type        KYCDocType
  fileUrl     String
  status      KYCStatus   @default(PENDING)
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_documents")
}

model PaymentIntent {
  id          String   @id @default(uuid())
  processorId String   @unique @map("processor_id")
  userId      String   @map("user_id")
  amount      Decimal  @db.Decimal(18, 8)
  currency    String
  method      String
  status      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@index([userId, status])
  @@map("payment_intents")
}

model KYCVerification {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  provider        String
  providerRef     String?  @map("provider_ref")
  status          String
  rejectionReason String?  @map("rejection_reason")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  @@index([userId, status])
  @@map("kyc_verifications")
}

model AMLScreening {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  provider   String
  status     String
  riskLevel  String   @map("risk_level")
  matchCount Int      @map("match_count") @default(0)
  matches    Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("aml_screenings")
}

// ─── TRADING ACCOUNTS ─────────────────────────────────────────────────────────

model TradingAccount {
  id            String          @id @default(uuid())
  userId        String
  accountNumber String          @unique @default(uuid())
  accountType   AccountType     @default(STANDARD)
  currency      String          @default("USD")
  balance       Decimal         @default(0.00) @db.Decimal(18, 8)
  equity        Decimal         @default(0.00) @db.Decimal(18, 8)
  margin        Decimal         @default(0.00) @db.Decimal(18, 8)
  freeMargin    Decimal         @default(0.00) @db.Decimal(18, 8)
  leverage      Int             @default(100)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades        Trade[]
  transactions  Transaction[]

  @@map("trading_accounts")
}

// ─── TRADES ───────────────────────────────────────────────────────────────────

model Trade {
  id              String        @id @default(uuid())
  accountId       String
  symbol          String
  type            TradeType
  status          TradeStatus   @default(OPEN)
  lotSize         Decimal       @db.Decimal(10, 4)
  openPrice       Decimal       @db.Decimal(18, 8)
  closePrice      Decimal?      @db.Decimal(18, 8)
  stopLoss        Decimal?      @db.Decimal(18, 8)
  takeProfit      Decimal?      @db.Decimal(18, 8)
  profit          Decimal?      @db.Decimal(18, 8)
  commission      Decimal       @default(0.00) @db.Decimal(18, 8)
  swap            Decimal       @default(0.00) @db.Decimal(18, 8)
  openedAt        DateTime      @default(now())
  closedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  account         TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("trades")
}

model DemoOrder {
  id         String          @id @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  instrument String
  type       DemoOrderType
  side       DemoOrderSide
  price      Decimal?        @db.Decimal(20, 8)
  amount     Decimal         @db.Decimal(20, 8)
  leverage   Int
  stopLoss   Decimal?        @map("stop_loss") @db.Decimal(20, 8)
  takeProfit Decimal?        @map("take_profit") @db.Decimal(20, 8)
  status     DemoOrderStatus @default(open)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([instrument, status])
  @@map("demo_orders")
}

// ─── TRANSACTIONS ─────────────────────────────────────────────────────────────

model Transaction {
  id              String              @id @default(uuid())
  userId          String
  accountId       String
  type            TransactionType
  status          TransactionStatus   @default(PENDING)
  amount          Decimal             @db.Decimal(18, 8)
  currency        String              @default("USD")
  fee             Decimal             @default(0.00) @db.Decimal(18, 8)
  reference       String              @unique @default(uuid())
  gateway         String?
  gatewayRef      String?
  notes           String?
  processedAt     DateTime?
  is_demo         Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         TradingAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

// ─── USER SESSIONS ────────────────────────────────────────────────────────────

model UserSession {
  id          String    @id
  userId      String    @db.Uuid @map("user_id")
  isAdmin     Boolean   @map("is_admin") @default(false)
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @map("created_at") @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id          String              @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  isRead      Boolean             @default(false)
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── AUDIT LOGS ───────────────────────────────────────────────────────────────

model AuditLog {
  id          String    @id @default(uuid())
  userId      String?
  action      String
  entity      String?
  entityId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ─── MARKET DATA ──────────────────────────────────────────────────────────────

model MarketSymbol {
  id            String    @id @default(uuid())
  symbol        String    @unique
  name          String
  category      String
  baseCurrency  String
  quoteCurrency String
  minLot        Decimal   @db.Decimal(10, 4)
  maxLot        Decimal   @db.Decimal(10, 4)
  lotStep       Decimal   @db.Decimal(10, 4)
  spread        Decimal   @db.Decimal(10, 5)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("market_symbols")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SUPPORT
  CLIENT
}

enum KYCStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum KYCDocType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENSE
  PROOF_OF_ADDRESS
  SELFIE
}

enum AccountType {
  DEMO
  STANDARD
  PREMIUM
  VIP
  ISLAMIC
  MANAGED
}

enum TradeType {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
  PENDING
  CANCELLED
}

enum DemoOrderType {
  market
  limit
  stop
}

enum DemoOrderSide {
  buy
  sell
}

enum DemoOrderStatus {
  open
  filled
  cancelled
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INTERNAL_TRANSFER
  BONUS
  COMMISSION
  SWAP
  PROFIT
  LOSS
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum NotificationType {
  TRADE_OPENED
  TRADE_CLOSED
  DEPOSIT_RECEIVED
  WITHDRAWAL_PROCESSED
  KYC_APPROVED
  KYC_REJECTED
  ACCOUNT_ALERT
  SYSTEM_MESSAGE
  MARGIN_CALL
}
