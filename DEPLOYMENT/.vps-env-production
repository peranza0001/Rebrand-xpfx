# VPS/PM2 Production Environment
# Generated: 2026-08-14
# Save as: /var/www/Rebrand-xpfx/.env on your VPS
# Or use: DEPLOYMENT/vps-deploy.sh to automate setup

# ========== CORE APPLICATION ==========
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ========== ALLOWED ORIGINS (CRITICAL - Update with your domain) ==========
# Format: comma-separated list of trusted origins
# REPLACE with your actual domain and IP
ALLOWED_ORIGINS=https://xpressprofx.com,https://www.xpressprofx.com,http://localhost:3000,http://127.0.0.1:3000

# ========== DATABASE (Local PostgreSQL on VPS) ==========
# Ensure PostgreSQL 14+ is running on VPS
# Default: postgresql://postgres:password@localhost:5432/xpressprofx
DATABASE_URL=postgresql://postgres:CHANGE_ME_PASSWORD@localhost:5432/xpressprofx
DIRECT_DATABASE_URL=postgresql://postgres:CHANGE_ME_PASSWORD@localhost:5432/xpressprofx

# ========== SESSION & AUTH SECRETS (Generated - DO NOT MODIFY) ==========
SESSION_SECRET=CHANGE_ME_GENERATE_OUTSIDE_GIT
JWT_SECRET=CHANGE_ME_GENERATE_OUTSIDE_GIT
COOKIE_SECRET=CHANGE_ME_GENERATE_OUTSIDE_GIT
CSRF_SECRET=CHANGE_ME_GENERATE_OUTSIDE_GIT
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_OUTSIDE_GIT
COOKIE_SIGNING_KEY=CHANGE_ME_GENERATE_OUTSIDE_GIT

# ========== WALLET ENCRYPTION (Generated - DO NOT MODIFY) ==========
WALLET_ENCRYPTION_KEY=CHANGE_ME_GENERATE_OUTSIDE_GIT

# ========== ADMIN CREDENTIALS (CRITICAL - Create strong password) ==========
# Set to your admin email and a strong password (min 16 chars, mixed case, numbers, symbols)
ADMIN_EMAIL=admin@xpressprofx.com
ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_16_CHARS_MIN
ADMIN_NOTIFY_EMAIL=admin@xpressprofx.com

# ========== EMAIL SERVICE (SMTP - SendGrid Recommended) ==========
# Get free SendGrid account at sendgrid.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.YOUR_SENDGRID_API_KEY_HERE
SMTP_FROM=noreply@xpressprofx.com

# ========== BLOCKCHAIN & PAYMENT INTEGRATIONS ==========
# Alchemy (get free key at alchemy.com)
ALCHEMY_API_KEY=your-alchemy-api-key-here

# MoonPay (optional - for fiat on/off ramps; leave empty for sandbox mode)
MOONPAY_API_KEY=your-moonpay-api-key-here
MOONPAY_SECRET_KEY=your-moonpay-secret-key-here

# Coinbase (optional - for crypto payments; leave empty for permissive webhook mode)
COINBASE_API_KEY=your-coinbase-api-key-here
COINBASE_SECRET_KEY=your-coinbase-secret-key-here
COINBASE_WEBHOOK_SECRET=your-coinbase-webhook-secret-here

# Paystack (optional - for African payments)
PAYSTACK_PUBLIC_KEY=your-paystack-public-key-here
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here

# ========== AI INTEGRATIONS (Optional) ==========
AI_INTEGRATIONS_ENABLED=false
OPENAI_API_KEY=your-openai-api-key-if-enabled

# ========== BUSINESS SETTINGS ==========
REFERRAL_REWARD_USD=500
PREVIEW_MODE=false

# ========== DEPLOYMENT PLATFORM DETECTION ==========
# Not used on VPS (leave empty)
RAILWAY_ENVIRONMENT_NAME=
REPLIT_DOMAINS=
