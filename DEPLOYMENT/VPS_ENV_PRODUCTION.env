# VPS / PM2 Production Environment Template
# Copy this to /var/www/Rebrand-xpfx/.env on the VPS

NODE_ENV=production
PORT=3000
ENABLE_DEMO_AUTH=false

# ──────────────────────────────────────────────────────────────
# CORS and Origins
# ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://xpressprofx.com,https://www.xpressprofx.com,http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# ──────────────────────────────────────────────────────────────
# Secrets (GENERATE THESE WITH: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ──────────────────────────────────────────────────────────────
SESSION_SECRET=
JWT_SECRET=
COOKIE_SECRET=
CSRF_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SIGNING_KEY=

# Wallet encryption key (64-char hex):
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
WALLET_ENCRYPTION_KEY=

# ──────────────────────────────────────────────────────────────
# Database (local PostgreSQL on VPS or remote connection)
# ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpass@localhost:5432/xpressprofx
DIRECT_DATABASE_URL=postgresql://postgres:yourpass@localhost:5432/xpressprofx

# ──────────────────────────────────────────────────────────────
# Admin Credentials
# ──────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@xpressprofx.com
ADMIN_PASSWORD=
ADMIN_NOTIFY_EMAIL=alerts@xpressprofx.com

# ──────────────────────────────────────────────────────────────
# Email (SendGrid or local SMTP)
# ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM=no_reply@xpressprofx.com
SMTP_SECURE=false

# ──────────────────────────────────────────────────────────────
# Blockchain & Payment Providers
# ──────────────────────────────────────────────────────────────
ALCHEMY_API_KEY=
MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_WEBHOOK_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────────
# AI Integrations
# ──────────────────────────────────────────────────────────────
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# ──────────────────────────────────────────────────────────────
# Business Settings
# ──────────────────────────────────────────────────────────────
REFERRAL_REWARD_USD=500
LOG_LEVEL=info
