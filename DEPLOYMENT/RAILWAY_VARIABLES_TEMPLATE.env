# Railway variables template - DO NOT COMMIT REAL SECRETS.
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL=postgresql://username:replace-with-password@host:5432/database?sslmode=require
PGHOST=host
PGPORT=5432
PGUSER=username
PGPASSWORD=replace-with-password
PGDATABASE=database
PGSSLMODE=require
JWT_SECRET=replace-with-jwt-secret
SESSION_SECRET=replace-with-session-secret
COOKIE_SIGNING_KEY=replace-with-cookie-signing-key
WEBHOOK_SECRET_GLOBAL=replace-with-webhook-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-admin-password
ALLOWED_ORIGINS=https://app.yourdomain.example,https://www.yourdomain.example
API_PROXY=https://api.yourdomain.example
VITE_API_BASE=https://api.yourdomain.example
ENABLE_DETAILED_ERRORS=false
WALLET_ENABLED=true
SALT_ROUNDS=12
SENTRY_DSN=replace-with-sentry-dsn
SENDGRID_API_KEY=replace-with-sendgrid-key
ALCHEMY_API_KEY=replace-with-alchemy-key
MOONPAY_API_KEY=replace-with-moonpay-key
MOONPAY_SECRET=replace-with-moonpay-secret
MOONPAY_WEBHOOK_URL=https://api.yourdomain.example/webhooks/moonpay
COINBASE_API_KEY=replace-with-coinbase-key
COINBASE_API_SECRET=replace-with-coinbase-secret
COINBASE_WEBHOOK_SECRET=replace-with-coinbase-webhook-secret
PAYSTACK_SECRET=replace-with-paystack-secret
PAYSTACK_PUBLIC=replace-with-paystack-public
PAYSTACK_WEBHOOK_SECRET=replace-with-paystack-webhook-secret
OPENAI_API_KEY=replace-with-openai-key
AI_PROVIDER=openai
AI_TIMEOUT_MS=30000
BACKUP_SCHEDULE=0 2 * * *
