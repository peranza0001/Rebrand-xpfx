modules = ["nodejs-20", "web", "bash", "postgresql-16"]
language = "nodejs"
entrypoint = "artifacts/api-server/src/index.ts"
packager = "npm"
run = "npm run replit:start"

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["npm", "run", "build:replit"]
run = ["npm", "run", "replit:start"]

[workflows]
runButton = "Project"

[agent]
stack = "nodejs"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
