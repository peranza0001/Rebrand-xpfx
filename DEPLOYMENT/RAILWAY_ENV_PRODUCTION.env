# Railway Production Environment Template
# Copy this and fill in real values, then paste into Railway dashboard

NODE_ENV=production
PORT=8080
ENABLE_DEMO_AUTH=false

# ──────────────────────────────────────────────────────────────
# Frontend Configuration (Critical for deployed frontends)
# ──────────────────────────────────────────────────────────────
# Set this to the API endpoint URL that your frontend will call
# Options:
#   1. Same Railway app (internal): http://localhost:8080
#   2. Same Railway app (external): https://your-railway-app.up.railway.app
#   3. Different domain: https://api.yourdomain.com
VITE_API_URL=https://your-railway-app.up.railway.app

# ──────────────────────────────────────────────────────────────
# CORS and Origins (CRITICAL - UPDATE FOR YOUR DOMAIN)
# ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://xpressprofx.com,https://www.xpressprofx.com,https://your-railway-app.up.railway.app

# ──────────────────────────────────────────────────────────────
# Secrets (GENERATE THESE WITH: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ──────────────────────────────────────────────────────────────
SESSION_SECRET=
JWT_SECRET=
COOKIE_SECRET=
CSRF_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SIGNING_KEY=

# Wallet encryption key (64-char hex):
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
WALLET_ENCRYPTION_KEY=

# ──────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────
DATABASE_URL=
DIRECT_DATABASE_URL=

# ──────────────────────────────────────────────────────────────
# Admin Credentials
# ──────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@xpressprofx.com
ADMIN_PASSWORD=
ADMIN_NOTIFY_EMAIL=alerts@xpressprofx.com

# ──────────────────────────────────────────────────────────────
# Email (SendGrid)
# ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM=no_reply@xpressprofx.com
SMTP_SECURE=false

# ──────────────────────────────────────────────────────────────
# Blockchain & Payment Providers
# ──────────────────────────────────────────────────────────────
ALCHEMY_API_KEY=
MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_WEBHOOK_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────────
# AI Integrations
# ──────────────────────────────────────────────────────────────
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# ──────────────────────────────────────────────────────────────
# Business Settings
# ──────────────────────────────────────────────────────────────
REFERRAL_REWARD_USD=500
LOG_LEVEL=info
