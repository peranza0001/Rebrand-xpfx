# Production Environment Configuration Template
# Copy this file to .env and fill in all values
# NEVER COMMIT .env - only .env.example is committed

# ═══════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Pooled connection (used by running application)
DATABASE_URL=postgresql://user:password@hostname:5432/database_name?sslmode=require&schema=public

# Direct connection (ONLY for Prisma migrations, not for running app)
DIRECT_DATABASE_URL=postgresql://user:password@hostname:5432/database_name?sslmode=require&schema=public

# ═══════════════════════════════════════════════════════════════════════════
# SECURITY & SECRETS (Generate with: node -e "require('crypto').randomBytes(32).toString('hex')")
# ═══════════════════════════════════════════════════════════════════════════

SESSION_SECRET=your_secure_random_64_char_hex_string_here
COOKIE_SECRET=your_secure_random_64_char_hex_string_here
JWT_SECRET=your_secure_random_base64_string_here
JWT_REFRESH_SECRET=your_secure_random_base64_string_here
CSRF_SECRET=your_secure_random_32_char_hex_string_here
COOKIE_SIGNING_KEY=your_secure_random_64_char_hex_string_here
WALLET_ENCRYPTION_KEY=your_secure_random_64_char_hex_string_here

# ═══════════════════════════════════════════════════════════════════════════
# ADMIN CREDENTIALS (CHANGE IMMEDIATELY AFTER FIRST LOGIN)
# ═══════════════════════════════════════════════════════════════════════════

ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMe123!PickStrongPassword

# ═══════════════════════════════════════════════════════════════════════════
# ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=8080
LOG_LEVEL=info
ENABLE_DEMO_AUTH=false

# ═══════════════════════════════════════════════════════════════════════════
# NETWORK & ORIGINS (CRITICAL - UPDATE FOR YOUR DOMAIN)
# ═══════════════════════════════════════════════════════════════════════════

# Comma-separated list of allowed origins (NEVER use * in production)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com

# Frontend URL for API routing
VITE_API_URL=https://api.yourdomain.com
VITE_API_TIMEOUT=30000

# ═══════════════════════════════════════════════════════════════════════════
# EMAIL CONFIGURATION (REQUIRED for production)
# ═══════════════════════════════════════════════════════════════════════════

# SendGrid (Recommended)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SMTP_FROM=noreply@yourdomain.com

# OR SMTP (Alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password

# ═══════════════════════════════════════════════════════════════════════════
# BLOCKCHAIN & INTEGRATIONS
# ═══════════════════════════════════════════════════════════════════════════

# Alchemy API (for blockchain data)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# MoonPay (for fiat-to-crypto)
MOONPAY_API_KEY=your_moonpay_api_key
MOONPAY_SECRET_KEY=your_moonpay_secret_key
MOONPAY_WEBHOOK_SECRET=your_moonpay_webhook_secret

# Coinbase Commerce
COINBASE_API_KEY=your_coinbase_api_key
COINBASE_API_SECRET=your_coinbase_api_secret
COINBASE_WEBHOOK_SECRET=your_coinbase_webhook_secret

# Paystack
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL INTEGRATIONS
# ═══════════════════════════════════════════════════════════════════════════

# OpenAI (for AI features)
AI_INTEGRATIONS_OPENAI_API_KEY=sk_your_openai_api_key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Stripe (for payments - if using)
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_PUBLIC_KEY=pk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ═══════════════════════════════════════════════════════════════════════════
# MONITORING & ANALYTICS
# ═══════════════════════════════════════════════════════════════════════════

# Sentry (error tracking)
SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id

# Google Analytics
GOOGLE_ANALYTICS_ID=G_your_ga_id_here

# ═══════════════════════════════════════════════════════════════════════════
# CUSTOM CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Referral reward amount (USD)
REFERRAL_REWARD_USD=500

# Demo account configuration
DEMO_STARTING_BALANCE=50000
DEMO_ACCOUNT_EXPIRY_DAYS=30

# ═══════════════════════════════════════════════════════════════════════════
# NOTES & REMINDERS
# ═══════════════════════════════════════════════════════════════════════════
#
# 1. NEVER commit .env to version control
# 2. Always use strong, randomly generated secrets
# 3. Rotate secrets regularly (quarterly minimum)
# 4. Use platform secrets manager (Railway, Vercel, etc.)
# 5. Update ALLOWED_ORIGINS for your production domain
# 6. Test all integrations before launching
# 7. Set up monitoring and alerting before production
# 8. Keep backups of critical secrets in secure location
# 9. Document all secret rotation procedures
# 10. Test disaster recovery procedures regularly
#
