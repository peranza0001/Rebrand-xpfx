# XpressPro FX — default environment values
# These defaults are intentionally safe placeholders for local bootstrap.
# Real credentials must be supplied by the deployment platform or a local .env override.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:change_me_secure_password@db.example.internal:5432/railway
DIRECT_DATABASE_URL=postgresql://postgres:change_me_secure_password@db.example.internal:5432/railway

# ─── Session & Tokens ───────────────────────────────────────────────────────
SESSION_SECRET=change_me_session_secret
COOKIE_SECRET=
JWT_SECRET=change_me_jwt_secret
COOKIE_SIGNING_KEY=
CSRF_SECRET=
JWT_REFRESH_SECRET=
WEBHOOK_SECRET_GLOBAL=

# ─── Admin Seed Credentials ─────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com,ops@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NOTIFY_EMAIL=admin@example.com

# ─── Wallet Encryption ──────────────────────────────────────────────────────
WALLET_ENCRYPTION_KEY=change_me_wallet_encryption_key

# ─── Demo Access ─────────────────────────────────────────────────────────────
ENABLE_DEMO_AUTH=false

# ─── Required Production Variables ───────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ALLOWED_ORIGINS: comma-separated list of allowed frontend origins for CORS.
# Examples:
#   Railway:  https://yourdomain-production.railway.app
#   Render:   https://yourdomain.onrender.com
#   Vercel:   https://yourdomain.vercel.app
#   Custom:   https://app.yourdomain.com,https://admin.yourdomain.com
#   Local:    http://localhost:5173,http://localhost:5174
# If not set, brand domain fallbacks (xpressprofx.com) are used as last resort.
ALLOWED_ORIGINS=https://rebrand-xpfx-api-server.vercel.app,https://web-production-94f970.up.railway.app

# Frontend URL: Base URL for password reset links, email templates, etc.
# Aliases: PUBLIC_APP_URL, APP_URL, PRODUCTION_URL (env name is interchangeable)
# If not set, defaults to https://app.xpressprofx.com
PUBLIC_APP_URL=https://rebrand-xpfx-api-server.vercel.app
FRONTEND_URL=https://rebrand-xpfx-api-server.vercel.app
VITE_API_URL=https://web-production-94f970.up.railway.app

# ─── Email (SendGrid / SMTP) ─────────────────────────────────────────────────
SENDGRID_API_KEY=SG.generated_placeholder_do_not_use
SMTP_FROM=support@xpressprofx.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.generated_placeholder_do_not_use
SMTP_SECURE=false

# ─── CORS (Development) ───────────────────────────────────────────────────────
# For local development, add frontend dev server ports here.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── On-chain (Alchemy) ───────────────────────────────────────────────────────
# Preferred provider for blockchain lookups. Replace with your real Alchemy key.
ALCHEMY_API_KEY=<your-real-alchemy-api-key>

# ─── MoonPay ──────────────────────────────────────────────────────────────────
MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_WEBHOOK_SECRET=

# ─── Coinbase ───────────────────────────────────────────────────────────────
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_WEBHOOK_SECRET=

# ─── OpenAI / AI chat ───────────────────────────────────────────────────────
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
AI_INTEGRATIONS_OPENAI_MODEL=gpt-4.1-mini

# ─── Paystack ─────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ─── Referral ─────────────────────────────────────────────────────────────────
# USD reward amount for successful referrals (default: 500)
REFERRAL_REWARD_USD=500

# ─── Optional / Platform-specific ────────────────────────────────────────────
# API proxy target for local frontend dev (e.g. http://localhost:3000)
API_PROXY_TARGET=
