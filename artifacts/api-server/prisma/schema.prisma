generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ────────────────────────────────────────────────────────────────────

model User {
  id                         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                   String       @unique
  email                      String       @unique
  fullName                   String       @map("full_name")
  phone                      String?
  country                    String?
  passwordHash               String       @map("password_hash")
  loginPin                   String?      @map("login_pin")
  walletKeyCode              String?      @map("wallet_key_code")
  securityType               String       @map("security_type")
  role                       String       @default("user")
  kycVerified                Boolean      @map("kyc_verified") @default(false)
  kycStatus                  String       @map("kyc_status") @default("unverified")
  emailVerified              Boolean      @map("email_verified") @default(false)
  phoneVerified              Boolean      @map("phone_verified") @default(false)
  emailVerifyToken           String?      @map("email_verify_token")
  resetPasswordToken         String?      @map("reset_password_token")
  resetPasswordExpiry        DateTime?    @map("reset_password_expiry")
  avatarUrl                  String?      @map("avatar_url")
  selectedManagerId          String?      @map("selected_manager_id")
  demoMode                   Boolean      @map("demo_mode") @default(false)
  aiBotTrialEndsAt           DateTime?    @map("ai_bot_trial_ends_at")
  aiBotSubscriptionStatus    String       @map("ai_bot_subscription_status") @default("trial")
  maintenanceDueAt           DateTime?    @map("maintenance_due_at")
  maintenanceGraceEndsAt     DateTime?    @map("maintenance_grace_ends_at")
  lastCompulsoryTradeAt      DateTime?    @map("last_compulsory_trade_at")
  tradingLocked              Boolean      @map("trading_locked") @default(false)
  lastActivity               DateTime     @map("last_activity") @default(now())
  createdAt                  DateTime     @map("created_at") @default(now())
  referralCode               String?      @map("referral_code") @unique
  referredBy                 String?      @map("referred_by")
  referralValidUntil         DateTime?    @map("referral_valid_until")
  isNewUser                  Boolean      @map("is_new_user") @default(true)
  moonpayEmail               String?      @map("moonpay_email")
  buyVerified                Boolean      @map("buy_verified") @default(false)

  sessions                   UserSession[]
  transactions               Transaction[]
  notifications              Notification[]
  kycDocuments               KYCDocument[]
  tradingAccounts            TradingAccount[]
  auditLogs                  AuditLog[]

  @@map("users")
}

// ─── KYC DOCUMENTS ────────────────────────────────────────────────────────────

model KYCDocument {
  id          String      @id @default(uuid())
  userId      String
  type        KYCDocType
  fileUrl     String
  status      KYCStatus   @default(PENDING)
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_documents")
}

// ─── TRADING ACCOUNTS ─────────────────────────────────────────────────────────

model TradingAccount {
  id            String          @id @default(uuid())
  userId        String
  accountNumber String          @unique @default(uuid())
  accountType   AccountType     @default(STANDARD)
  currency      String          @default("USD")
  balance       Decimal         @default(0.00) @db.Decimal(18, 8)
  equity        Decimal         @default(0.00) @db.Decimal(18, 8)
  margin        Decimal         @default(0.00) @db.Decimal(18, 8)
  freeMargin    Decimal         @default(0.00) @db.Decimal(18, 8)
  leverage      Int             @default(100)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades        Trade[]
  transactions  Transaction[]

  @@map("trading_accounts")
}

// ─── TRADES ───────────────────────────────────────────────────────────────────

model Trade {
  id              String        @id @default(uuid())
  accountId       String
  symbol          String
  type            TradeType
  status          TradeStatus   @default(OPEN)
  lotSize         Decimal       @db.Decimal(10, 4)
  openPrice       Decimal       @db.Decimal(18, 8)
  closePrice      Decimal?      @db.Decimal(18, 8)
  stopLoss        Decimal?      @db.Decimal(18, 8)
  takeProfit      Decimal?      @db.Decimal(18, 8)
  profit          Decimal?      @db.Decimal(18, 8)
  commission      Decimal       @default(0.00) @db.Decimal(18, 8)
  swap            Decimal       @default(0.00) @db.Decimal(18, 8)
  openedAt        DateTime      @default(now())
  closedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  account         TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("trades")
}

// ─── TRANSACTIONS ─────────────────────────────────────────────────────────────

model Transaction {
  id              String              @id @default(uuid())
  userId          String
  accountId       String
  type            TransactionType
  status          TransactionStatus   @default(PENDING)
  amount          Decimal             @db.Decimal(18, 8)
  currency        String              @default("USD")
  fee             Decimal             @default(0.00) @db.Decimal(18, 8)
  reference       String              @unique @default(uuid())
  gateway         String?
  gatewayRef      String?
  notes           String?
  processedAt     DateTime?
  is_demo         Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         TradingAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

// ─── USER SESSIONS ────────────────────────────────────────────────────────────

model UserSession {
  id          String    @id
  userId      String    @db.Uuid @map("user_id")
  isAdmin     Boolean   @map("is_admin") @default(false)
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @map("created_at") @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id          String              @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  isRead      Boolean             @default(false)
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── AUDIT LOGS ───────────────────────────────────────────────────────────────

model AuditLog {
  id          String    @id @default(uuid())
  userId      String?
  action      String
  entity      String?
  entityId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ─── MARKET DATA ──────────────────────────────────────────────────────────────

model MarketSymbol {
  id            String    @id @default(uuid())
  symbol        String    @unique
  name          String
  category      String
  baseCurrency  String
  quoteCurrency String
  minLot        Decimal   @db.Decimal(10, 4)
  maxLot        Decimal   @db.Decimal(10, 4)
  lotStep       Decimal   @db.Decimal(10, 4)
  spread        Decimal   @db.Decimal(10, 5)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("market_symbols")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SUPPORT
  CLIENT
}

enum KYCStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum KYCDocType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENSE
  PROOF_OF_ADDRESS
  SELFIE
}

enum AccountType {
  DEMO
  STANDARD
  PREMIUM
  VIP
  ISLAMIC
  MANAGED
}

enum TradeType {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
  PENDING
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INTERNAL_TRANSFER
  BONUS
  COMMISSION
  SWAP
  PROFIT
  LOSS
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum NotificationType {
  TRADE_OPENED
  TRADE_CLOSED
  DEPOSIT_RECEIVED
  WITHDRAWAL_PROCESSED
  KYC_APPROVED
  KYC_REJECTED
  ACCOUNT_ALERT
  SYSTEM_MESSAGE
  MARGIN_CALL
}
